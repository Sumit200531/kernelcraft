{
  "name": "@kernelcraft/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KernelCraft HTTP API: simulation, analysis, assistant and recorded experiments (PostgreSQL).",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/main.js --packages=external --alias:@kernelcraft/engine=../../packages/engine/src/index.ts && cp -r migrations dist/",
    "migrate": "tsx src/migrate-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@fastify/static": "8.1.0",
    "@kernelcraft/engine": "0.1.0",
    "fastify": "5.2.1",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "embedded-postgres": "17.9.0-beta.17",
    "esbuild": "0.24.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
